---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import LeiaTambem from '../../components/LeiaTambem.astro';
import { getCollection } from 'astro:content';
import { CATS, ICONS, CTA_TXT, fmtData, ANUNCIOS } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const { Content } = await post.render();
const todos = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
/* links internos: matérias da mesma categoria primeiro, depois as mais recentes; sem repetir a mesma matéria */
const jaLinkadas = new Set([...(post.body || '').matchAll(/\]\(\/blog\/([^/)#?]+)/g)].map((m) => m[1]));
const outras = todos.filter((p) => p.slug !== post.slug);
const fila = [...outras.filter((p) => p.data.category === d.category), ...outras.filter((p) => p.data.category !== d.category)];
const semRepetir = fila.filter((p) => !jaLinkadas.has(p.slug));
const leia1 = semRepetir[0];
const leia2 = semRepetir[1];
const idx = todos.findIndex((p) => p.slug === post.slug);
const proxima = [todos[idx + 1], todos[0], todos[1]].find((p) => p && p.slug !== post.slug && p !== leia1 && p !== leia2) || semRepetir[2];
const anterior = [todos[idx - 1], todos[idx + 2]].find((p) => p && p.slug !== post.slug && p !== proxima && p !== leia1 && p !== leia2);
const rel = fila.filter((p) => p !== leia1 && p !== leia2 && p !== proxima && p !== anterior).slice(0, 4);
/* barra lateral "Mais recentes" (computador) */
const recentes = todos.filter((p) => p.slug !== post.slug).slice(0, 4);
const cta = CTA_TXT[post.slug] || CTA_TXT['cat-' + d.category] || CTA_TXT.padrao;
const ctaMsg = cta[2].replace('{t}', d.title);
const url = new URL(`/blog/${post.slug}/`, Astro.site).href;
const jsonld: object[] = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.summary, datePublished: d.date.toISOString(), dateModified: d.date.toISOString(), inLanguage: 'pt-BR', mainEntityOfPage: url,
    image: new URL(d.cover || '/img/og-joao-maia-consorcios.png', Astro.site).href,
    author: { '@type': 'Person', name: 'João Maia', jobTitle: 'Consultor de consórcios' }, publisher: { '@type': 'Organization', name: 'João Maia Consórcios' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url }] }
];
if (d.faq.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={d.seo_title || `${d.title} | João Maia Consórcios`} description={d.summary} ctx={`blog: ${post.slug}`} ogType="article" image={d.cover} jsonld={jsonld}>
  <div class="wrap post" style="padding-top:40px">
    <article>
      <nav class="crumb" aria-label="Você está em"><a href="/">Início</a> / <a href="/blog/">Blog</a> / <a href={`/blog/?categoria=${d.category}`}>{CATS[d.category]}</a></nav>
      <h1>{d.title}</h1>
      <div class="byline"><span class="av" aria-hidden="true">JM</span><div class="by-txt"><span><b style="color:var(--ink)">João Maia</b>, consultor de consórcios</span><span class="by-meta"><time datetime={d.date.toISOString()}>{fmtData(d.date)}</time></span></div></div>
      {ANUNCIOS && <div class="ad h250 ad-titulo">Anúncio · logo abaixo do título · 728x90 ou 336x280</div>}
      {d.cover
        ? <img src={d.cover} alt={d.cover_alt || d.title} width="1200" height="630" style="width:100%;height:auto;aspect-ratio:1200/630;object-fit:cover;border-radius:16px" />
        : <div class="cv" style="aspect-ratio:1200/630;border-radius:16px"><Fragment set:html={ICONS[d.category] || ICONS.imovel} /><span>{CATS[d.category]}</span></div>}
      <div class="post-body"><Content /></div>

      {ANUNCIOS && <div class="ad h250" id="ad-meio" hidden>Anúncio · após o 2º parágrafo</div>}
      {leia1 && <LeiaTambem post={leia1} id="leia-1" pos="meio-1" />}
      {leia2 && <LeiaTambem post={leia2} id="leia-2" pos="meio-2" />}
      <div class="inline-cta" id="cta-meio" hidden><div><b style="font-size:19px;font-family:var(--f-display)">{cta[0]}</b><span>{cta[1]}</span></div><a class="btn btn-orange" data-cta={`artigo-${post.slug}`} data-wa={ctaMsg} href="#">Falar com o João</a></div>

      {d.faq.length > 0 && (
        <>
          <h2>Perguntas frequentes</h2>
          <div>{d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
        </>
      )}
      {(proxima || anterior) && (
        <nav class="post-nav" aria-label="Outras matérias">
          {proxima && (
            <a class="prox-mat" href={`/blog/${proxima.slug}/`} data-link-interno="proxima">
              <span class="prox-k">Próxima matéria</span>
              <strong>{proxima.data.title}</strong>
              <span class="prox-go" aria-hidden="true">→</span>
            </a>
          )}
          {anterior && (
            <a class="ant-mat" href={`/blog/${anterior.slug}/`} data-link-interno="anterior">
              <span class="ant-go" aria-hidden="true">←</span>
              <span class="ant-tx"><span class="prox-k">Matéria anterior</span><strong>{anterior.data.title}</strong></span>
            </a>
          )}
        </nav>
      )}
      <div class="author"><span class="av" aria-hidden="true">JM</span><div><b>Escrito por João Maia</b><p style="color:var(--ink-soft);font-size:15px">Consultor Ademicon em Ribeirão Preto. Explica consórcio sem enrolação para quem vai conquistar o primeiro imóvel ou o primeiro carro.</p></div><a class="btn btn-night" href="/#simulador">Fazer o teste</a></div>
      {ANUNCIOS && <div class="ad h250">Anúncio final · fim do artigo</div>}
      {rel.length > 0 && (<><h2 style="font-size:24px">Leia também</h2><div class="cards cards-blog cards-rel">{rel.map((p) => <Card post={p} />)}</div></>)}
    </article>
    <aside>
      <div class="side"><span class="kicker">Teste de 1 minuto</span><b style="font-family:var(--f-display);font-size:22px;line-height:1.15">O consórcio é para você?</b><p>Quatro perguntas e você descobre o caminho que combina com o seu momento.</p><a class="btn btn-orange" href="/#simulador">Fazer o teste</a></div>
      {ANUNCIOS && <div class="ad h600">Anúncio lateral · 300x600<br>só desktop</div>}
      {recentes.length > 0 && (
        <div class="recentes">
          <span class="mono" style="color:var(--ink-soft)">Mais recentes</span>
          {recentes.map((p) => (
            <a href={`/blog/${p.slug}/`} data-link-interno="lateral">
              {p.data.cover ? <img src={p.data.cover} alt="" loading="lazy" width="1200" height="630" /> : <span class="rc-ic" aria-hidden="true"></span>}
              <span>{p.data.title}</span>
            </a>
          ))}
        </div>
      )}
      <div class="catbox"><span class="mono" style="color:var(--ink-soft)">Categorias</span>{Object.entries(CATS).map(([k, c]) => <a href={`/blog/?categoria=${k}`}>{c}</a>)}</div>
    </aside>
  </div>
</Base>
